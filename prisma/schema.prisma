generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Prisma 7 uses the pg driver adapter (see lib/prisma.ts) — queries go
  // through the JS `pg` driver, not the native Rust query engine, so the
  // Vercel/RHEL binary target is not required at runtime. Declared anyway as
  // harmless insurance in case the driver adapter is ever removed.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Category {
  COMING_SOON_SALE
  COMING_SOON_RENTAL
  OFF_MARKET_SALE
  ACTIVE_SALE_LISTING
  RENTAL_LISTING
  BUYER_ISO
  RENTER_INQUIRY
  SELLER_LEAD
  LANDLORD_LEAD
  DEVELOPMENT_INVENTORY
  COMING_SOON_DEVELOPMENT
  SPONSOR_UNIT
  OPEN_HOUSE
  PRICE_DROP
  BACK_ON_MARKET
  MARKET_REPORT
  REAL_ESTATE_EVENT
  CLIENT_CONVERSATION
  SHOWING_CONFIRMATION
  NOISE
}

enum TransactionType {
  SALE
  RENTAL
  BUYER_NEED
  RENTER_NEED
  SELLER_LEAD
  LANDLORD_LEAD
  UNKNOWN
}

// Brief 7.0 — reason a party↔listing match was dismissed by the user. The reason
// is FORWARD-LOOKING: Brief 7.1+ can auto-re-surface a dismissed match when the
// reason no longer applies (e.g. a WRONG_PRICE dismissal clears on a price drop).
// Not used for filtering in 7.0 — a MatchDismissal row hides the pair regardless
// of reason.
enum DismissalReason {
  WRONG_PRICE
  WRONG_NEIGHBORHOOD
  WRONG_TIMING
  GHOSTED
  OTHER
}

// Brief 7.1 — qualitative match tier from the Brief 7.0 matching engine
// (lib/matching/tiering.ts scores each party↔listing pair Hot/Warm/Possible).
// Stored on Match so the UI can render a tier chip. Nullable: legacy Match rows
// written by the classic runMatchmaking() sync path carry no tier and must keep
// rendering cleanly (type badge + score only).
enum MatchTier {
  HOT
  WARM
  POSSIBLE
}

// ── Tenancy ─────────────────────────────────────────────────────────────────
model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  plan        String    @default("trial")
  dpaSignedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users            User[]
  mailboxes        ConnectedMailbox[]
  emails           RawEmail[]
  opportunities    ExtractedOpportunity[]
  searchQueries    SearchQuery[]
  auditLogs        AuditLog[]
  chatSessions     ChatSession[]
  chatMessages     ChatMessage[]
  mojoRaws         MojoRaw[]
  mojoContacts     MojoContact[]
  instantlyEvents  InstantlyEvent[]
  matches          Match[]
  pushSubs         PushSubscription[]
  attachments      Attachment[]
  properties       Property[]
  listingHistory   ListingStatusHistory[]
  propertyIntel    PropertyIntelligence[]
  reviewItems      ReviewQueueItem[]
  aiLogs           AIExtractionLog[]
  outcomes         OutcomeFeedback[]
  chunks           DocumentChunk[]
  threads          EmailThread[]
  linkedResources  LinkedResource[]
  nycParcelCache   NycParcelCache[]
  notificationPrefs NotificationPreferences?
  zapierIngestLogs ZapierIngestLog[]
  callQueueEntries CallQueueEntry[]
  callLogs         CallLog[]
  valuationRuns      ValuationRun[]       // Brief 44
  propertyValuations PropertyValuation[]  // Brief 44
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  microsoftUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  mailboxes ConnectedMailbox[]
  emails    RawEmail[]

  @@index([organizationId])
}

model ConnectedMailbox {
  id                    String    @id @default(cuid())
  userId                String?
  email                 String
  provider              String    @default("microsoft")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  lastSyncAt            DateTime?
  deltaLink             String?
  readOnlyMode          Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  user   User?      @relation(fields: [userId], references: [id])
  emails RawEmail[]

  @@index([organizationId])
}

model RawEmail {
  id                String    @id @default(cuid())
  userId            String?
  mailboxId         String?
  graphMessageId    String    @unique
  internetMessageId String?
  subject           String
  senderName        String?
  senderEmail       String?
  receivedDateTime  DateTime
  bodyPreview       String?
  bodyContent       String?
  bodyContentType   String?
  attachmentsText   String?
  webLink           String?
  rawJson           Json?
  processed         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  classifierStatus     String?
  classifierCategory   String?
  classifierConfidence Float?
  extractionStatus     String?
  extractorType        String?
  extractorVersion     String?
  extractionAttempts   Int       @default(0)
  lastProcessedAt      DateTime?
  processingError      String?
  embeddedAt           DateTime?
  matchedAt            DateTime?
  idempotencyKey       String?

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  threadId String?
  thread   EmailThread? @relation(fields: [threadId], references: [id])

  user          User?             @relation(fields: [userId], references: [id])
  mailbox       ConnectedMailbox? @relation(fields: [mailboxId], references: [id])
  opportunities ExtractedOpportunity[]
  attachments   Attachment[]

  @@index([organizationId])
  @@index([threadId])
}

model ExtractedOpportunity {
  id                   String          @id @default(cuid())
  rawEmailId           String
  category             Category
  transactionType      TransactionType
  propertyType         String?
  propertyTypeReason   String?   // Phase 4.6 — NYC enrichment trace
  address              String?
  neighborhood         String?
  borough              String?
  city                 String?
  state                String?
  zip                  String?
  price                Float?
  minPrice             Float?
  maxPrice             Float?
  beds                 Float?
  baths                Float?
  units                Float?
  squareFeet           Float?
  availabilityDate     String?
  sourceAgentName      String?
  sourceAgentEmail     String?
  sourceBrokerage      String?
  clientSide           String?
  status               String?

  // Brief 6.3 — extraction provenance. null = direct extraction (default);
  // 'comp_reference' = derived from a sold/historical comp (EXCLUDED from match
  // pools — a comp is not a live lead); 'buried_recovery' = surfaced by the
  // lead-recovery second pass over an informational-tone email.
  provenance           String?

  // Phase 4.0.7 — demand-side criteria, folded in from the deprecated
  // CriteriaProfile table. Populated for BUYER_ISO / RENTER_INQUIRY.
  neighborhoods   String[]  @default([])
  propertyTypes   String[]  @default([])
  minBeds         Int?
  maxBeds         Int?
  // Brief 32.A.1 — buyer-side baths preference (unblocks the baths feature).
  bathsMin        Int?
  bathsMax        Int?
  mustHaves       String?
  dealbreakers    String?
  timeline        String?
  criteriaActive  Boolean   @default(true)

  // Brief 32 — buyer archetype (BUYER_ISO only) + property intelligence (listing side).
  buyerArchetype       String?   // CASH_BUYER | EXCHANGE_1031 | TRADITIONAL_FINANCING |
                                 // INVESTOR_LANDLORD | FIRST_TIME_FHA | LUXURY_ALL_CASH |
                                 // LUXURY_FINANCED
  monthlyMaintenance   Float?    // co-op
  monthlyCommonCharges Float?    // condo
  monthlyTaxes         Float?    // monthly (annual/12), all types
  yearBuilt            Int?
  lotSizeSqft          Float?
  zoningCode           String?
  // NOTE: buildingSqft → use existing squareFeet; unitCount → use existing units.

  extractedTitle       String
  extractedSummary     String
  classificationReason String
  confidenceScore      Float
  isDuplicate          Boolean  @default(false)
  duplicateGroupId     String?
  duplicateOfId        String?
  embedding            Unsupported("vector(1536)")?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  processingStatus     String   @default("active")
  propertyId           String?
  isTestData           Boolean  @default(false)

  streetEasyId         String?
  streetEasyStatus     String?
  streetEasyCheckedAt  DateTime?

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  rawEmail  RawEmail  @relation(fields: [rawEmailId], references: [id])
  // Brief 32 — the Match.opportunityId FK was dropped (supply may now be a MojoContact),
  // so the reverse relation is gone. Match rows are resolved by opportunityId+opportunityType.
  property  Property? @relation(fields: [propertyId], references: [id])
  reports   Report[]  // Brief 27.0 — reports whose subject is this opportunity

  @@index([organizationId])
  @@index([processingStatus])
  @@index([category, processingStatus])
  // Phase 4.0.7 — GIN indexes for array-containment on folded-in criteria arrays
  @@index([neighborhoods(ops: ArrayOps)], type: Gin)
  @@index([propertyTypes(ops: ArrayOps)], type: Gin)
}

model SearchQuery {
  id                 String   @id @default(cuid())
  queryText          String
  parsedCriteriaJson Json?
  resultCount        Int
  createdAt          DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  detailsJson Json?
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String?
  archived  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  messages  ChatMessage[]
  reports   Report[]   // Brief 27.0 — reports generated within this session

  @@index([organizationId])
}

model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String
  content     String
  dealsJson   Json?
  suggestions Json?
  // Brief 27.0 — report attachments, so the chat page can rehydrate them (Phase 1b).
  // attachedReport = full-report preview card metadata; attachedFragment = inline section content.
  attachedReport   Json?
  attachedFragment Json?
  createdAt   DateTime    @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// Brief 27.0 — a generated full report (Report Engine Phase 1a). Fragments are
// NOT stored here (they attach to a ChatMessage). buyerId is a loose indexed
// string, not an FK: for buyer-match it references a BUYER_ISO ExtractedOpportunity,
// but future templates may key on a MojoContact or an address — polymorphic, so
// no relation. opportunityId (the report's subject property, when applicable) IS
// a nullable FK.
model Report {
  id             String    @id @default(cuid())
  templateId     String    // e.g. "buyer-match"
  params         Json      // input params, e.g. { buyerId: "abc" }
  sections       Json      // filled section outputs (SectionResult[])
  markdown       String    @db.Text // pre-rendered markdown for the Copy button
  sources        Json      // provenance array: [{ type, id?, at }]
  sessionId      String
  session        ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    ExtractedOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  buyerId        String?   // loose reference (see model note) — indexed, no FK
  createdAt      DateTime  @default(now())

  @@index([sessionId])
  @@index([templateId])
  @@index([buyerId])
  @@index([opportunityId])
}

model MojoRaw {
  id         Int      @id @default(autoincrement())
  mojoId     String?
  firstName  String?
  lastName   String?
  phone      String?
  phone2     String?
  email      String?
  address    String?
  city       String?
  state      String?
  zipCode    String?
  status     String?
  notes      String?
  tags       String?
  mojoList   String?
  lastCalled String?
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("mojo_raw")
}

model MojoContact {
  id               String   @id @default(cuid())
  mojoId           String   @unique
  fullName         String
  phone            String?
  email            String?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  neighborhood     String?
  status           String?
  tags             String[]
  notes            String?
  mojoGroup        String?
  mojoList         String?
  groups              String[]
  isTestData           Boolean  @default(false)
  intent               String?  @default("SELLER")   // SELLER / BUYER / RENTER — TEXT, not enum
  bedsMin              Int?
  bedsMax              Int?
  budgetMin            Float?
  budgetMax            Float?
  cashOnly             Boolean?
  timing               String?
  initialNeighborhood  String?
  metadata             Json?              // catch-all for future Mojo custom fields
  lastCalled          DateTime?
  lastDialDate        DateTime?
  estimatedValue      Float?
  equityBalance       Float?
  currentLTV          Float?
  totalLoanBalance    Float?
  loanInterestRate    Float?

  // Brief 32 — SELLER property + motivation intelligence (all additive/nullable).
  // Property beds/baths (SELLER intent — the property has N beds/baths).
  propertyBeds            Float?
  propertyBaths           Float?
  // Distress / motivation signals.
  preForeclosureStatus    String?    // NONE | LIS_PENDENS | NOTICE_OF_DEFAULT | AUCTION_SCHEDULED | null
  foreclosureAuctionDate  DateTime?
  isVacant                Boolean?
  ownerOccupied           Boolean?
  alternateAddress        String?    // owner mailing addr if != property addr
  coOwnerFullName         String?
  // Property intelligence.
  lastSaleDate            DateTime?
  lastSalePrice           Float?
  yearBuilt               Int?
  unitCount               Int?
  buildingSqft            Float?
  lotSizeSqft             Float?
  zoningCode              String?
  propertyTypeDetail      String?    // Duplex | SFH | Coop | Condo | Townhouse | ...
  // Listing history.
  priorListingStatus      String?    // EXPIRED | WITHDRAWN | ACTIVE | SOLD | NEVER_LISTED | null
  priorListingDom         Int?
  priorListingBrokerage   String?
  priorListingPrice       Float?
  // Contact quality / compliance (arrays aligned: [primary, ...additional]).
  additionalPhones        String[]   @default([])
  additionalEmails        String[]   @default([])
  phoneDncFlags           Boolean[]  @default([])
  phoneTypes              String[]   @default([])   // 'mobile' | 'landline'
  // 3rd-party scoring.
  batchRankCategory       String?    // Low | Medium | High

  embedding           Unsupported("vector(1536)")?
  instantlyStatus     String?
  instantlyCampaignId String?
  syncedAt            DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  instantlyEvents     InstantlyEvent[]
  callQueueEntries    CallQueueEntry[]   // Brief 33 — ranked call-queue snapshots
  callLogs            CallLog[]          // Brief 33 — schema only (Brief 34 populates)
  valuations          PropertyValuation[] // Brief 44 — DealFlow's own value, one row per monthly run

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model ZapierIngestLog {
  id               String   @id @default(cuid())
  receivedAt       DateTime @default(now())
  organizationId   String
  headers          Json     // request headers Zapier sent
  body             Json     // raw payload verbatim
  resultStatus     String   @default("pending")  // pending / upserted / rejected / errored
  resultReason     String?  // e.g. "header_row_reject", or error message
  resultContactId  String?  // mojoContact.id if successfully upserted
  processedAt      DateTime?
  organization     Organization @relation(fields: [organizationId], references: [id])
  @@index([organizationId, receivedAt])
  @@map("zapier_ingest_log")
}

model InstantlyEvent {
  id           String       @id @default(cuid())
  email        String
  contactId    String?
  contact      MojoContact? @relation(fields: [contactId], references: [id])
  campaignId   String?
  campaignName String?
  eventType    String
  payload      Json?
  occurredAt   DateTime     @default(now())
  createdAt    DateTime     @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Match {
  id              String   @id @default(cuid())
  opportunityId   String
  // Brief 32 — the supply/listing side is no longer always an ExtractedOpportunity.
  // 'opportunity' → opportunityId references ExtractedOpportunity.id (default; every
  // pre-Brief-32 row is retroactively tagged this by the default). 'contact' →
  // opportunityId references MojoContact.id (a SELLER contact acting as the supply).
  // The FK to ExtractedOpportunity was dropped so a MojoContact id can live here;
  // consumers branch on opportunityType to resolve the supply record.
  opportunityType String   @default("opportunity")
  counterpartId   String
  counterpartType String
  score           Int
  reason          String?
  tier            MatchTier? // Brief 7.1 — nullable; legacy sync-path rows have none
  seen            Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Brief 32 scorer outputs. Brief 32.A.1 honesty pass: the fabricated numeric
  // capture-probability was replaced by an honest categorical capture status, the
  // always-null gross-compensation stub was dropped, and a matchFit confidence
  // meta-signal (derived from the unknownFactors count) was added.
  captureStatus       String?   // OWN_BOTH_SIDES | OWN_LISTING_ONLY | OWN_BUYER_ONLY | EXTERNAL_BOTH
  matchFitConfidence  String?   // HIGH | MEDIUM | LOW
  contributions       Json?
  unknownFactors      String[]  @default([])

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@unique([opportunityId, counterpartId, counterpartType])
  @@index([organizationId])
  @@index([seen])
  @@index([createdAt])
}

// Brief 7.0 — a user-dismissed party↔listing pair. The matching engine filters
// out any pair with a row here, regardless of reason. dismissalReason is
// forward-looking (see DismissalReason enum) and NOT consulted for filtering in
// 7.0. No time-decay: a dismissal is permanent until explicitly cleared or,
// later (7.1+), auto-cleared when its reason no longer applies.
model MatchDismissal {
  id              String           @id @default(cuid())
  partyId         String
  listingId       String
  dismissedAt     DateTime         @default(now())
  dismissedBy     String?          // nullable — future: user id
  dismissalReason DismissalReason? // nullable — nice-to-have, not required in 7.0

  @@unique([partyId, listingId])
  @@index([partyId])
  @@index([listingId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// Brief 7.4 — per-org notification preferences (single-tenant: one row per org =
// per Ryan, mirroring PushSubscription's org-scoping since there is no per-user
// auth/session identity yet). digestTime is a naive local "HH:mm" (ET). The cron
// fires at a fixed schedule; digestTime is stored for a future per-user schedule
// and shown in Settings today.
model NotificationPreferences {
  id              String   @id @default(cuid())
  digestEnabled   Boolean  @default(true)
  realtimeEnabled Boolean  @default(true)
  digestTime      String   @default("08:00")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
}

// ── Phase 1 New Models (updated for chunking + tenancy) ─────────────────────

model Attachment {
  id              String   @id @default(cuid())
  rawEmailId      String
  name            String
  mimeType        String
  sizeBytes       Int?
  contentBytes    Bytes?
  extractedText   String?
  parseError      String?
  parsedPages     Json?
  tableCount      Int      @default(0)
  imageCount      Int      @default(0)
  llamaParseJobId String?
  parseProvider   String?
  createdAt       DateTime @default(now())

