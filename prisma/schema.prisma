generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  COMING_SOON_SALE
  COMING_SOON_RENTAL
  OFF_MARKET_SALE
  ACTIVE_SALE_LISTING
  RENTAL_LISTING
  BUYER_ISO
  RENTER_INQUIRY
  SELLER_LEAD
  LANDLORD_LEAD
  DEVELOPMENT_INVENTORY
  COMING_SOON_DEVELOPMENT
  SPONSOR_UNIT
  OPEN_HOUSE
  PRICE_DROP
  BACK_ON_MARKET
  MARKET_REPORT
  REAL_ESTATE_EVENT
  CLIENT_CONVERSATION
  SHOWING_CONFIRMATION
  NOISE
}

enum TransactionType {
  SALE
  RENTAL
  BUYER_NEED
  RENTER_NEED
  SELLER_LEAD
  LANDLORD_LEAD
  UNKNOWN
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  microsoftUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mailboxes ConnectedMailbox[]
  emails    RawEmail[]
}

model ConnectedMailbox {
  id                    String    @id @default(cuid())
  userId                String?
  email                 String
  provider              String    @default("microsoft")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  lastSyncAt            DateTime?
  deltaLink             String?
  readOnlyMode          Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user   User?      @relation(fields: [userId], references: [id])
  emails RawEmail[]
}

model RawEmail {
  id                String    @id @default(cuid())
  userId            String?
  mailboxId         String?
  graphMessageId    String    @unique
  internetMessageId String?
  subject           String
  senderName        String?
  senderEmail       String?
  receivedDateTime  DateTime
  bodyPreview       String?
  bodyContent       String?
  bodyContentType   String?
  attachmentsText   String?
  webLink           String?
  rawJson           Json?
  processed         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // ── Processing checkpoints (Phase 1) ──
  classifierStatus     String?   // 'pending' | 'classified' | 'failed'
  classifierCategory   String?
  classifierConfidence Float?
  extractionStatus     String?   // 'pending' | 'extracted' | 'failed' | 'skipped'
  extractorType        String?
  extractorVersion     String?
  extractionAttempts   Int       @default(0)
  lastProcessedAt      DateTime?
  processingError      String?
  embeddedAt           DateTime?
  matchedAt            DateTime?
  idempotencyKey       String?   // hash(rawEmailId + extractorType + promptVersion)

  user          User?             @relation(fields: [userId], references: [id])
  mailbox       ConnectedMailbox? @relation(fields: [mailboxId], references: [id])
  opportunities ExtractedOpportunity[]
  attachments   Attachment[]
}

model ExtractedOpportunity {
  id                   String          @id @default(cuid())
  rawEmailId           String
  category             Category
  transactionType      TransactionType
  propertyType         String?
  address              String?
  neighborhood         String?
  borough              String?
  city                 String?
  state                String?
  zip                  String?
  price                Float?
  minPrice             Float?
  maxPrice             Float?
  beds                 Float?
  baths                Float?
  units                Float?
  squareFeet           Float?
  availabilityDate     String?
  sourceAgentName      String?
  sourceAgentEmail     String?
  sourceBrokerage      String?
  clientSide           String?
  status               String?
  extractedTitle       String
  extractedSummary     String
  classificationReason String
  confidenceScore      Float
  isDuplicate          Boolean  @default(false)
  duplicateGroupId     String?
  duplicateOfId        String?
  embedding            Unsupported("vector(1536)")?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // ── Phase 1 additions ──
  processingStatus     String   @default("active")
  // Values: "active" | "needs_review" | "draft" | "rejected" | "duplicate" | "stale"
  propertyId           String?

  // ── Test data flag ──
  isTestData           Boolean  @default(false)

  // ── StreetEasy sync ──
  streetEasyId         String?
  streetEasyStatus     String?   // "active" | "delisted" | "in_contract" | "sold" | "unknown"
  streetEasyCheckedAt  DateTime?

  rawEmail  RawEmail  @relation(fields: [rawEmailId], references: [id])
  matches   Match[]
  property  Property? @relation(fields: [propertyId], references: [id])

  @@index([processingStatus])
  @@index([category, processingStatus])
}

model SearchQuery {
  id                 String   @id @default(cuid())
  queryText          String
  parsedCriteriaJson Json?
  resultCount        Int
  createdAt          DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  detailsJson Json?
  createdAt   DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String?
  archived  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String
  content     String
  dealsJson   Json?
  suggestions Json?
  createdAt   DateTime    @default(now())
}

// Staging table — API Nation writes raw Mojo rows here. /api/mojo/process transforms them into MojoContact.
model MojoRaw {
  id         Int      @id @default(autoincrement())
  mojoId     String?
  firstName  String?
  lastName   String?
  phone      String?
  phone2     String?
  email      String?
  address    String?
  city       String?
  state      String?
  zipCode    String?
  status     String?
  notes      String?
  tags       String?
  mojoList   String?
  lastCalled String?
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("mojo_raw")
}

model MojoContact {
  id               String   @id @default(cuid())
  mojoId           String   @unique
  fullName         String
  phone            String?
  email            String?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  neighborhood     String?
  status           String?
  tags             String[]
  notes            String?
  mojoGroup        String?
  mojoList         String?
  groups              String[]
  lastCalled          DateTime?
  lastDialDate        DateTime?
  estimatedValue      Float?
  equityBalance       Float?
  currentLTV          Float?
  totalLoanBalance    Float?
  loanInterestRate    Float?
  embedding           Unsupported("vector(1536)")?
  instantlyStatus     String?   // null | "enrolled" | "suppressed" | "unsubscribed"
  instantlyCampaignId String?
  syncedAt            DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  instantlyEvents     InstantlyEvent[]
}

model InstantlyEvent {
  id           String      @id @default(cuid())
  email        String
  contactId    String?
  contact      MojoContact? @relation(fields: [contactId], references: [id])
  campaignId   String?
  campaignName String?
  eventType    String      // opened | replied | bounced | clicked | interested | unsubscribed
  payload      Json?
  occurredAt   DateTime    @default(now())
  createdAt    DateTime    @default(now())
}

model Match {
  id              String   @id @default(cuid())
  opportunityId   String
  counterpartId   String
  counterpartType String
  score           Int
  reason          String?
  seen            Boolean  @default(false)
  createdAt       DateTime @default(now())

  opportunity ExtractedOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([seen])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ── Phase 1 New Models ────────────────────────────────────────────────────────

model Attachment {
  id            String   @id @default(cuid())
  rawEmailId    String
  name          String
  mimeType      String
  sizeBytes     Int?
  extractedText String?
  parseError    String?
  createdAt     DateTime @default(now())
  rawEmail      RawEmail @relation(fields: [rawEmailId], references: [id])
}

model Property {
  id                String   @id @default(cuid())
  normalizedAddress String
  unitNumber        String?
  neighborhood      String?
  borough           String?
  zip               String?
  propertyType      String?
  block             String?
  lot               String?
  bbl               String?
  currentOwner      String?
  lastSaleDate      String?
  lastSalePrice     Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  opportunities ExtractedOpportunity[]
  statusHistory ListingStatusHistory[]
  intelligence  PropertyIntelligence[]

  @@index([normalizedAddress])
  @@index([bbl])
}

model ListingStatusHistory {
  id            String   @id @default(cuid())
  propertyId    String?
  opportunityId String?
  fromStatus    String?
  toStatus      String
  source        String
  detectedAt    DateTime @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
}

model PropertyIntelligence {
  id         String   @id @default(cuid())
  address    String
  source     String
  dataJson   Json
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime
  propertyId String?

  property Property? @relation(fields: [propertyId], references: [id])

  @@unique([address, source])
  @@index([expiresAt])
}

model CriteriaProfile {
  id            String   @id @default(cuid())
  opportunityId String?  @unique
  type          String
  agentName     String?
  agentEmail    String?
  brokerage     String?
  neighborhoods String[]
  borough       String?
  minPrice      Float?
  maxPrice      Float?
  minBeds       Int?
  maxBeds       Int?
  propertyTypes String[]
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ReviewQueueItem {
  id                  String    @id @default(cuid())
  opportunityId       String?
  rawEmailId          String?
  flagReason          String
  suggestedAction     String?
  status              String    @default("pending")
  reviewedAt          DateTime?
  reviewNotes         String?
  userCorrectedFields Json?
  createdAt           DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

model AIExtractionLog {
  id               String   @id @default(cuid())
  rawEmailId       String?
  opportunityId    String?
  idempotencyKey   String?  @unique
  model            String
  extractorType    String?
  extractorVersion String   @default("1.0")
  promptVersion    String   @default("1.0")
  schemaVersion    String   @default("1.0")
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float?
  confidenceScore  Float?
  durationMs       Int?
  error            String?
  createdAt        DateTime @default(now())

  @@index([rawEmailId])
  @@index([createdAt])
}

model OutcomeFeedback {
  id            String   @id @default(cuid())
  opportunityId String?
  matchId       String?
  action        String
  notes         String?
  createdAt     DateTime @default(now())

  @@index([opportunityId])
}

model FeatureFlag {
  id        String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Phase X.0 — monthly RapidAPI quota counter + hard-pause state.
// One row per yearMonth ("2026-05"). callsConsumed increments at the
// chokepoint in lib/streetEasySync.ts:seRequest. Hard pause at 4900/5000.
model RapidApiUsage {
  id              String   @id @default(cuid())
  yearMonth       String   @unique
  callsConsumed   Int      @default(0)
  monthlyBudget   Int      @default(10000)
  warnedAt80      Boolean  @default(false)
  warnedAt90      Boolean  @default(false)
  warnedAt95      Boolean  @default(false)
  pausedAt        DateTime?
  updatedAt       DateTime @updatedAt
}
