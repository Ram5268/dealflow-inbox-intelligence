// ── New chunking + threading models (empty for now; populated in Phase 2+) ──

model DocumentChunk {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  parentEmailId          String?
  parentAttachmentId     String?
  parentLinkedResourceId String?
  threadId               String?

  chunkType       String
  content         String
  pageNumber      Int?
  sectionHeading  String?
  hasTable        Boolean @default(false)
  hasImage        Boolean @default(false)
  tokenCount      Int?

  embeddingModel   String
  embeddingVersion String
  embeddedAt       DateTime?

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  attachment       Attachment?      @relation(fields: [parentAttachmentId], references: [id])
  linkedResource   LinkedResource?  @relation(fields: [parentLinkedResourceId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId, chunkType])
  @@index([organizationId, parentEmailId])
  @@index([organizationId, threadId])
  @@index([organizationId, propertyId])
}

model EmailThread {
  id                  String   @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  graphConversationId String
  subjectRoot         String
  participants        String[]
  firstMessageAt      DateTime
  lastMessageAt       DateTime
  messageCount        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  emails RawEmail[]

  @@unique([organizationId, graphConversationId])
  @@index([organizationId, lastMessageAt])
}

model LinkedResource {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  parentEmailId      String

  url                String
  resourceType       String
  fetchStatus        String
  fetchedAt          DateTime?
  fetchError         String?
  parsedMarkdown     String?
  parsedAttachmentId String?

  chunks DocumentChunk[]

  createdAt DateTime @default(now())

  @@index([organizationId, parentEmailId])
  @@index([fetchStatus])
}

// Phase 4.6 — Cache of NYC public-data lookups keyed on normalized address
model NycParcelCache {
  id                   String    @id @default(cuid())
  normalizedAddress    String    @unique
  bbl                  String?
  bin                  String?
  borough              String?
  geosearchConfidence  Float?
  geosearchLabel       String?
  latitude             Float?
  longitude            Float?
  bldgclass            String?
  ownername            String?
  unitsRes             Int?
  unitsTotal           Int?
  yearBuilt            Int?
  plutoVersion         String?
  hasCondoDecl         Boolean?
  propertyType         String?
  propertyTypeReason   String
  confidence           String
  fetchedAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  @@index([organizationId])
  @@index([bbl])
}

// ── Brief 2.5 — Drift chat instrumentation ──────────────────────────────────
// Every Drift interaction leaves an auditable record: the query, the parsed
// filters, the cards actually shown, response time, and model/token/cost.
// Clicks and feedback are logged via POST /api/chat/interaction.
model DriftInteraction {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  query          String   @db.Text
  parsedFilters  Json?
  topCards       Json     // array of { id, kind, title, rank, score } — max 20
  responseTimeMs Int
  modelUsed      String
  tokensIn       Int?
  tokensOut      Int?
  costUsd        Float?

  clicks         DriftInteractionClick[]
  feedback       DriftInteractionFeedback[]

  @@index([createdAt])
}

model DriftInteractionClick {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  interactionId String
  cardId        String
  cardKind      String
  rank          Int

  interaction   DriftInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([interactionId])
}

model DriftInteractionFeedback {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  interactionId String
  vote          String   // "helpful" | "wrong_result" | "missing_result"
  note          String?  @db.Text

  interaction   DriftInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([interactionId])
}

// Brief 11.0, Fix #2 — one row per guarded chat turn. Records what Drift tried
// to say, the tools it called, the guard's verdict, and what actually reached
// Ryan. Purpose: measure how often the hallucination guard fires and which
// class of failure dominates, so future scope changes are data-driven rather
// than anecdote-driven. Written best-effort — a logging failure never blocks
// the chat response.
model GuardFireEvent {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  organizationId     String
  sessionId          String
  userTurn           String   @db.Text // the user message that triggered this response
  priorAssistantTurn String?  @db.Text // the assistant's prior turn (for context)
  assistantAttempt   String   @db.Text // what Sonnet first tried to say (pre-correction)
  toolCallsAttempted Json               // [{ name, input, totalMatched, cardIds }] this turn
  verifierVerdict    String             // 'pass' | 'retry' | 'refuse' | 'canned_fallback'
  verifierReason     String?  @db.Text // flagged-claim text on the final attempt, if any
  finalResponseSent  String?  @db.Text // what actually reached the user

  @@index([organizationId, createdAt])
  @@index([verifierVerdict])
}

// Brief 33 — persisted ranked call-queue snapshot. One row per contact per
// generation run. The nightly cron rewrites the queue; the viewer reads the
// latest generationRunId.
model CallQueueEntry {
  id                    String   @id @default(cuid())
  organizationId        String
  contactId             String                       // MojoContact.id
  rank                  Int                          // 1..N ordering
  priorityScore         Int                          // 0-100
  reason                String                       // short human "why"
  primaryMatchId        String?                      // driving match
  contributingMatchIds  String[]  @default([])       // other matches in the aggregate
  contributions         Json?                        // per-feature breakdown
  generationRunId       String                       // groups entries by regen batch
  generatedAt           DateTime  @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id])
  contact       MojoContact   @relation(fields: [contactId], references: [id])

  @@index([organizationId, generationRunId])
  @@index([organizationId, rank])
  @@index([generatedAt])
}

// Brief 33 — SCHEMA ONLY. Do NOT populate in Brief 33; Brief 34 handles inserts.
model CallLog {
  id             String   @id @default(cuid())
  organizationId String
  contactId      String                             // MojoContact.id
  queueEntryId   String?                            // queue entry that surfaced the call
  disposition    String                             // Brief 34 enum-as-string
  notes          String?
  durationSec    Int?
  initiatedAt    DateTime  @default(now())
  completedAt    DateTime?

  organization  Organization  @relation(fields: [organizationId], references: [id])
  contact       MojoContact   @relation(fields: [contactId], references: [id])

  @@index([organizationId, initiatedAt])
  @@index([contactId, initiatedAt])
}

// ── Brief 44 — the valuation estimator ──────────────────────────────────────
// A monthly job (valuation/, run on GitHub Actions) values every CRM seller's home
// from free public records and sends the results through POST
// /api/valuations/import. These two tables are its only storage; Property and its
// currentOwner column are not used. The values are DealFlow's own estimates: they
// appear only on Ryan's CRM lead page and never on anything a buyer or homeowner
// could see (Ryan's decision, 2026-10-17). No owner or party names are stored
// (Ryan's decision, 2026-10-17: PLUTO owner names stay erased).

// One row per job run, published or not.
model ValuationRun {
  id             String    @id               // the job's run id
  organizationId String
  runAt          DateTime                    // when the job started
  asOf           DateTime  @db.Date          // the values are as of this day
  dataThrough    DateTime  @db.Date          // the last city sale date the model saw
  modelVersion   String
  gatesPassed    Boolean                     // the job's own publish checks (re-checked here before publishing)
  gatesJson      Json
  metricsJson    Json                        // accuracy on recent months, range widths: no values, no addresses
  scoreboardJson Json?                       // matching scoreboard (shares only)
  sourcesJson    Json?                       // which public data versions the run used
  countsJson     Json
  expectedRows   Int                         // sellers the job will send before publishing
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  valuations   PropertyValuation[]

  @@index([organizationId, published, publishedAt])
}

// One row per CRM seller per run. A home the model can't value has value, low and
// high null and a reason.
model PropertyValuation {
  id             String   @id @default(cuid())
  runId          String
  organizationId String
  contactId      String                      // MojoContact.id of a CRM seller
  bbl            String?                     // the city tax lot the address matched
  value          Float?
  low            Float?                      // the range is sized to hold the sale price about 2 times in 3
  high           Float?
  asOf           DateTime @db.Date
  reason         String?                     // five_plus_units | condo_without_unit | not_found | other_property_type
  factsJson      Json?                       // whitelisted public-record facts (lib/valuations/contract.ts)
  compsJson      Json?                       // up to 8 nearby earlier arm's-length sales (public records)
  createdAt      DateTime @default(now())

  run          ValuationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  contact      MojoContact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([runId, contactId])
  @@index([contactId, createdAt])
  @@index([organizationId])
}
