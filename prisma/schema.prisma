model EmailThread {
  id                  String   @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  graphConversationId String
  subjectRoot         String
  participants        String[]
  firstMessageAt      DateTime
  lastMessageAt       DateTime
  messageCount        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  emails RawEmail[]

  @@unique([organizationId, graphConversationId])
  @@index([organizationId, lastMessageAt])
}

model LinkedResource {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  parentEmailId      String

  url                String
  resourceType       String
  fetchStatus        String
  fetchedAt          DateTime?
  fetchError         String?
  parsedMarkdown     String?
  parsedAttachmentId String?

  chunks DocumentChunk[]

  createdAt DateTime @default(now())

  @@index([organizationId, parentEmailId])
  @@index([fetchStatus])
}

// Phase 4.6 — Cache of NYC public-data lookups keyed on normalized address
model NycParcelCache {
  id                   String    @id @default(cuid())
  normalizedAddress    String    @unique
  bbl                  String?
  bin                  String?
  borough              String?
  geosearchConfidence  Float?
  geosearchLabel       String?
  latitude             Float?
  longitude            Float?
  bldgclass            String?
  ownername            String?
  unitsRes             Int?
  unitsTotal           Int?
  yearBuilt            Int?
  plutoVersion         String?
  hasCondoDecl         Boolean?
  propertyType         String?
  propertyTypeReason   String
  confidence           String
  fetchedAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  @@index([organizationId])
  @@index([bbl])
}

// ── Brief 2.5 — Drift chat instrumentation ──────────────────────────────────
// Every Drift interaction leaves an auditable record: the query, the parsed
// filters, the cards actually shown, response time, and model/token/cost.
// Clicks and feedback are logged via POST /api/chat/interaction.
model DriftInteraction {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  query          String   @db.Text
  parsedFilters  Json?
  topCards       Json     // array of { id, kind, title, rank, score } — max 20
  responseTimeMs Int
  modelUsed      String
  tokensIn       Int?
  tokensOut      Int?
  costUsd        Float?

  clicks         DriftInteractionClick[]
  feedback       DriftInteractionFeedback[]

  @@index([createdAt])
}

model DriftInteractionClick {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  interactionId String
  cardId        String
  cardKind      String
  rank          Int

  interaction   DriftInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([interactionId])
}

model DriftInteractionFeedback {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  interactionId String
  vote          String   // "helpful" | "wrong_result" | "missing_result"
  note          String?  @db.Text

  interaction   DriftInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([interactionId])
}

// Brief 11.0, Fix #2 — one row per guarded chat turn. Records what Drift tried
// to say, the tools it called, the guard's verdict, and what actually reached
// Ryan. Purpose: measure how often the hallucination guard fires and which
// class of failure dominates, so future scope changes are data-driven rather
// than anecdote-driven. Written best-effort — a logging failure never blocks
// the chat response.
model GuardFireEvent {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  organizationId     String
  sessionId          String
  userTurn           String   @db.Text // the user message that triggered this response
  priorAssistantTurn String?  @db.Text // the assistant's prior turn (for context)
  assistantAttempt   String   @db.Text // what Sonnet first tried to say (pre-correction)
  toolCallsAttempted Json               // [{ name, input, totalMatched, cardIds }] this turn
  verifierVerdict    String             // 'pass' | 'retry' | 'refuse' | 'canned_fallback'
  verifierReason     String?  @db.Text // flagged-claim text on the final attempt, if any
  finalResponseSent  String?  @db.Text // what actually reached the user

  @@index([organizationId, createdAt])
  @@index([verifierVerdict])
}
