generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Category {
  COMING_SOON_SALE
  COMING_SOON_RENTAL
  OFF_MARKET_SALE
  ACTIVE_SALE_LISTING
  RENTAL_LISTING
  BUYER_ISO
  RENTER_INQUIRY
  SELLER_LEAD
  LANDLORD_LEAD
  DEVELOPMENT_INVENTORY
  COMING_SOON_DEVELOPMENT
  SPONSOR_UNIT
  OPEN_HOUSE
  PRICE_DROP
  BACK_ON_MARKET
  MARKET_REPORT
  REAL_ESTATE_EVENT
  CLIENT_CONVERSATION
  SHOWING_CONFIRMATION
  NOISE
}

enum TransactionType {
  SALE
  RENTAL
  BUYER_NEED
  RENTER_NEED
  SELLER_LEAD
  LANDLORD_LEAD
  UNKNOWN
}

// ── Tenancy ─────────────────────────────────────────────────────────────────
model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  plan        String    @default("trial")
  dpaSignedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users            User[]
  mailboxes        ConnectedMailbox[]
  emails           RawEmail[]
  opportunities    ExtractedOpportunity[]
  searchQueries    SearchQuery[]
  auditLogs        AuditLog[]
  chatSessions     ChatSession[]
  chatMessages     ChatMessage[]
  mojoRaws         MojoRaw[]
  mojoContacts     MojoContact[]
  instantlyEvents  InstantlyEvent[]
  matches          Match[]
  pushSubs         PushSubscription[]
  attachments      Attachment[]
  properties       Property[]
  listingHistory   ListingStatusHistory[]
  propertyIntel    PropertyIntelligence[]
  criteriaProfiles CriteriaProfile[]
  reviewItems      ReviewQueueItem[]
  aiLogs           AIExtractionLog[]
  outcomes         OutcomeFeedback[]
  chunks           DocumentChunk[]
  threads          EmailThread[]
  linkedResources  LinkedResource[]
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  microsoftUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  mailboxes ConnectedMailbox[]
  emails    RawEmail[]

  @@index([organizationId])
}

model ConnectedMailbox {
  id                    String    @id @default(cuid())
  userId                String?
  email                 String
  provider              String    @default("microsoft")
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  lastSyncAt            DateTime?
  deltaLink             String?
  readOnlyMode          Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  user   User?      @relation(fields: [userId], references: [id])
  emails RawEmail[]

  @@index([organizationId])
}

model RawEmail {
  id                String    @id @default(cuid())
  userId            String?
  mailboxId         String?
  graphMessageId    String    @unique
  internetMessageId String?
  subject           String
  senderName        String?
  senderEmail       String?
  receivedDateTime  DateTime
  bodyPreview       String?
  bodyContent       String?
  bodyContentType   String?
  attachmentsText   String?
  webLink           String?
  rawJson           Json?
  processed         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  classifierStatus     String?
  classifierCategory   String?
  classifierConfidence Float?
  extractionStatus     String?
  extractorType        String?
  extractorVersion     String?
  extractionAttempts   Int       @default(0)
  lastProcessedAt      DateTime?
  processingError      String?
  embeddedAt           DateTime?
  matchedAt            DateTime?
  idempotencyKey       String?

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  threadId String?
  thread   EmailThread? @relation(fields: [threadId], references: [id])

  user          User?             @relation(fields: [userId], references: [id])
  mailbox       ConnectedMailbox? @relation(fields: [mailboxId], references: [id])
  opportunities ExtractedOpportunity[]
  attachments   Attachment[]

  @@index([organizationId])
  @@index([threadId])
}

model ExtractedOpportunity {
  id                   String          @id @default(cuid())
  rawEmailId           String
  category             Category
  transactionType      TransactionType
  propertyType         String?
  address              String?
  neighborhood         String?
  borough              String?
  city                 String?
  state                String?
  zip                  String?
  price                Float?
  minPrice             Float?
  maxPrice             Float?
  beds                 Float?
  baths                Float?
  units                Float?
  squareFeet           Float?
  availabilityDate     String?
  sourceAgentName      String?
  sourceAgentEmail     String?
  sourceBrokerage      String?
  clientSide           String?
  status               String?
  extractedTitle       String
  extractedSummary     String
  classificationReason String
  confidenceScore      Float
  isDuplicate          Boolean  @default(false)
  duplicateGroupId     String?
  duplicateOfId        String?
  embedding            Unsupported("vector(1536)")?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  processingStatus     String   @default("active")
  propertyId           String?
  isTestData           Boolean  @default(false)

  streetEasyId         String?
  streetEasyStatus     String?
  streetEasyCheckedAt  DateTime?

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  rawEmail  RawEmail  @relation(fields: [rawEmailId], references: [id])
  matches   Match[]
  property  Property? @relation(fields: [propertyId], references: [id])

  @@index([organizationId])
  @@index([processingStatus])
  @@index([category, processingStatus])
}

model SearchQuery {
  id                 String   @id @default(cuid())
  queryText          String
  parsedCriteriaJson Json?
  resultCount        Int
  createdAt          DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  detailsJson Json?
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String?
  archived  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  messages  ChatMessage[]

  @@index([organizationId])
}

model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String
  content     String
  dealsJson   Json?
  suggestions Json?
  createdAt   DateTime    @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model MojoRaw {
  id         Int      @id @default(autoincrement())
  mojoId     String?
  firstName  String?
  lastName   String?
  phone      String?
  phone2     String?
  email      String?
  address    String?
  city       String?
  state      String?
  zipCode    String?
  status     String?
  notes      String?
  tags       String?
  mojoList   String?
  lastCalled String?
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("mojo_raw")
}

model MojoContact {
  id               String   @id @default(cuid())
  mojoId           String   @unique
  fullName         String
  phone            String?
  email            String?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  neighborhood     String?
  status           String?
  tags             String[]
  notes            String?
  mojoGroup        String?
  mojoList         String?
  groups              String[]
  lastCalled          DateTime?
  lastDialDate        DateTime?
  estimatedValue      Float?
  equityBalance       Float?
  currentLTV          Float?
  totalLoanBalance    Float?
  loanInterestRate    Float?
  embedding           Unsupported("vector(1536)")?
  instantlyStatus     String?
  instantlyCampaignId String?
  syncedAt            DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  instantlyEvents     InstantlyEvent[]

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model InstantlyEvent {
  id           String       @id @default(cuid())
  email        String
  contactId    String?
  contact      MojoContact? @relation(fields: [contactId], references: [id])
  campaignId   String?
  campaignName String?
  eventType    String
  payload      Json?
  occurredAt   DateTime     @default(now())
  createdAt    DateTime     @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Match {
  id              String   @id @default(cuid())
  opportunityId   String
  counterpartId   String
  counterpartType String
  score           Int
  reason          String?
  seen            Boolean  @default(false)
  createdAt       DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  opportunity ExtractedOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, counterpartId, counterpartType])
  @@index([organizationId])
  @@index([seen])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// ── Phase 1 New Models (updated for chunking + tenancy) ─────────────────────

model Attachment {
  id              String   @id @default(cuid())
  rawEmailId      String
  name            String
  mimeType        String
  sizeBytes       Int?
  extractedText   String?
  parseError      String?
  parsedPages     Json?
  tableCount      Int      @default(0)
  imageCount      Int      @default(0)
  llamaParseJobId String?
  parseProvider   String?
  createdAt       DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  rawEmail RawEmail @relation(fields: [rawEmailId], references: [id])
  chunks   DocumentChunk[]

  @@index([organizationId])
}

model Property {
  id                String   @id @default(cuid())
  normalizedAddress String
  unitNumber        String?
  neighborhood      String?
  borough           String?
  zip               String?
  propertyType      String?
  block             String?
  lot               String?
  bbl               String?
  currentOwner      String?
  lastSaleDate      String?
  lastSalePrice     Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  opportunities ExtractedOpportunity[]
  statusHistory ListingStatusHistory[]
  intelligence  PropertyIntelligence[]
  chunks        DocumentChunk[]

  @@index([organizationId])
  @@index([normalizedAddress])
  @@index([bbl])
}

model ListingStatusHistory {
  id            String   @id @default(cuid())
  propertyId    String?
  opportunityId String?
  fromStatus    String?
  toStatus      String
  source        String
  detectedAt    DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  property Property? @relation(fields: [propertyId], references: [id])

  @@index([organizationId])
}

model PropertyIntelligence {
  id         String   @id @default(cuid())
  address    String
  source     String
  dataJson   Json
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime
  propertyId String?

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  property Property? @relation(fields: [propertyId], references: [id])

  @@unique([address, source])
  @@index([organizationId])
  @@index([expiresAt])
}

model CriteriaProfile {
  id            String   @id @default(cuid())
  opportunityId String?  @unique
  type          String
  agentName     String?
  agentEmail    String?
  brokerage     String?
  neighborhoods String[]
  borough       String?
  minPrice      Float?
  maxPrice      Float?
  minBeds       Int?
  maxBeds       Int?
  propertyTypes String[]
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model ReviewQueueItem {
  id                  String    @id @default(cuid())
  opportunityId       String?
  rawEmailId          String?
  flagReason          String
  suggestedAction     String?
  status              String    @default("pending")
  reviewedAt          DateTime?
  reviewNotes         String?
  userCorrectedFields Json?
  createdAt           DateTime  @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model AIExtractionLog {
  id               String   @id @default(cuid())
  rawEmailId       String?
  opportunityId    String?
  idempotencyKey   String?  @unique
  model            String
  extractorType    String?
  extractorVersion String   @default("1.0")
  promptVersion    String   @default("1.0")
  schemaVersion    String   @default("1.0")
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float?
  confidenceScore  Float?
  durationMs       Int?
  error            String?
  createdAt        DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([rawEmailId])
  @@index([createdAt])
}

model OutcomeFeedback {
  id            String   @id @default(cuid())
  opportunityId String?
  matchId       String?
  action        String
  notes         String?
  createdAt     DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([opportunityId])
}

model FeatureFlag {
  id        String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model RapidApiUsage {
  id              String    @id @default(cuid())
  yearMonth       String    @unique
  callsConsumed   Int       @default(0)
  monthlyBudget   Int       @default(10000)
  warnedAt80      Boolean   @default(false)
  warnedAt90      Boolean   @default(false)
  warnedAt95      Boolean   @default(false)
  pausedAt        DateTime?
  updatedAt       DateTime  @updatedAt
}

// ── New chunking + threading models (empty for now; populated in Phase 2+) ──

model DocumentChunk {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  parentEmailId          String?
  parentAttachmentId     String?
  parentLinkedResourceId String?
  threadId               String?

  chunkType       String
  content         String
  pageNumber      Int?
  sectionHeading  String?
  hasTable        Boolean @default(false)
  hasImage        Boolean @default(false)
  tokenCount      Int?

  embeddingModel   String
  embeddingVersion String
  embeddedAt       DateTime?
  qdrantPointId    String?  @unique

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  attachment       Attachment?      @relation(fields: [parentAttachmentId], references: [id])
  linkedResource   LinkedResource?  @relation(fields: [parentLinkedResourceId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId, chunkType])
  @@index([organizationId, parentEmailId])
  @@index([organizationId, threadId])
  @@index([organizationId, propertyId])
}

model EmailThread {
  id                  String   @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  graphConversationId String
  subjectRoot         String
  participants        String[]
  firstMessageAt      DateTime
  lastMessageAt       DateTime
  messageCount        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  emails RawEmail[]

  @@unique([organizationId, graphConversationId])
  @@index([organizationId, lastMessageAt])
}

model LinkedResource {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  parentEmailId      String

  url                String
  resourceType       String
  fetchStatus        String
  fetchedAt          DateTime?
  fetchError         String?
  parsedMarkdown     String?
  parsedAttachmentId String?

  chunks DocumentChunk[]

  createdAt DateTime @default(now())

  @@index([organizationId, parentEmailId])
  @@index([fetchStatus])
}
