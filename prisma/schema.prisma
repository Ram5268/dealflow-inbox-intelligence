model AIExtractionLog {
  id               String   @id @default(cuid())
  rawEmailId       String?
  opportunityId    String?
  idempotencyKey   String?  @unique
  model            String
  extractorType    String?
  extractorVersion String   @default("1.0")
  promptVersion    String   @default("1.0")
  schemaVersion    String   @default("1.0")
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float?
  confidenceScore  Float?
  durationMs       Int?
  error            String?
  createdAt        DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([rawEmailId])
  @@index([createdAt])
}

model OutcomeFeedback {
  id            String   @id @default(cuid())
  opportunityId String?
  matchId       String?
  action        String
  notes         String?
  createdAt     DateTime @default(now())

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([opportunityId])
}

model FeatureFlag {
  id        String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model RapidApiUsage {
  id              String    @id @default(cuid())
  yearMonth       String    @unique
  callsConsumed   Int       @default(0)
  monthlyBudget   Int       @default(10000)
  warnedAt80      Boolean   @default(false)
  warnedAt90      Boolean   @default(false)
  warnedAt95      Boolean   @default(false)
  pausedAt        DateTime?
  updatedAt       DateTime  @updatedAt
}

// ── New chunking + threading models (empty for now; populated in Phase 2+) ──

model DocumentChunk {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  parentEmailId          String?
  parentAttachmentId     String?
  parentLinkedResourceId String?
  threadId               String?

  chunkType       String
  content         String
  pageNumber      Int?
  sectionHeading  String?
  hasTable        Boolean @default(false)
  hasImage        Boolean @default(false)
  tokenCount      Int?

  embeddingModel   String
  embeddingVersion String
  embeddedAt       DateTime?

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  attachment       Attachment?      @relation(fields: [parentAttachmentId], references: [id])
  linkedResource   LinkedResource?  @relation(fields: [parentLinkedResourceId], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId, chunkType])
  @@index([organizationId, parentEmailId])
  @@index([organizationId, threadId])
  @@index([organizationId, propertyId])
