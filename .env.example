# ============================================================================
# DealFlow Inbox Intelligence — environment variables
# ============================================================================
# Copy to `.env` for local dev. For the Vercel deploy (Brief 9.0) every var in
# the REQUIRED and PROD-OVERRIDES sections must be set in the Vercel dashboard
# (Project → Settings → Environment Variables) for BOTH Production and Preview.
# Values here are intentionally blank — never commit real secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — app will not function correctly without these
# ---------------------------------------------------------------------------

# Postgres (Railway). LOCAL: direct connection string.
# PROD (Vercel): use Railway's POOLED (PgBouncer) URL + append
#   ?pgbouncer=true&connect_timeout=15
# Serverless functions open many short-lived connections; the pooled URL is
# required to avoid "too many connections" on Railway.
DATABASE_URL=

# Anthropic (Claude Sonnet 4.6) — extraction + chat (product-surface calls).
ANTHROPIC_API_KEY=

# OpenAI (gpt-4o-mini) — classification, query parsing, retitle, embeddings,
# and /api/transcribe (Whisper). Cheap utility calls only.
OPENAI_API_KEY=

# Selects the chat/classification provider path in lib/ai.ts. Defaults to
# 'openai' when unset. Leave as 'openai' unless intentionally switching.
AI_PROVIDER=openai

# ---- Microsoft Graph OAuth (read-only mail + calendar write) --------------
# Azure AD app registration. Redirect URI must be registered in Azure Portal.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=
# LOCAL:  http://localhost:3002/api/auth/callback
# PROD:   https://<your-vercel-url>/api/auth/callback   (must match Azure exactly)
AZURE_REDIRECT_URI=

# ---- Push notifications (web-push / VAPID) --------------------------------
# Generate with: npx web-push generate-vapid-keys
# VAPID keys are ORIGIN-bound — the prod deploy needs its own freshly generated
# pair (localhost keys won't deliver on the Vercel origin). See Brief 9.0 §1.5.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ---- Secrets guarding webhooks / cron -------------------------------------
# Shared secret for the Mojo/Zapier ingest webhook (x-mojo-webhook-secret header).
MOJO_WEBHOOK_SECRET=
# Shared secret for scheduled endpoints (digest + sync tick). Sent by the
# scheduler as `Authorization: Bearer <CRON_SECRET>` or `?secret=<CRON_SECRET>`.
CRON_SECRET=

# Absolute base URL of the deployment. Used to build opportunity deep-links in
# calendar-event notes (app/api/matches/[id]/schedule-showing).
# LOCAL: http://localhost:3002   PROD: https://<your-vercel-url>
BASE_URL=

# ---------------------------------------------------------------------------
# PROD OVERRIDES — different value in prod than local (Brief 9.0 §1.3)
# ---------------------------------------------------------------------------
# All three isolation gates ship LOCAL as guardrails; PROD flips them OFF so
# real Mojo hydration, matching, and Zapier ingest are unblocked.

# 'true' = seed data only (blocks real Mojo hydration in drafts/schedule).
# PROD: false
TEST_MODE_ONLY=false

# 'true' = extractor blocked from real Graph API + sync. PROD: false (unblocks Zapier/sync).
INGESTION_TEST_MODE_ONLY=false

# 'true' = matcher runs in test isolation. PROD: false (live matching on).
MATCHING_TEST_MODE_ONLY=false

# ---------------------------------------------------------------------------
# OPTIONAL — feature flags & tuning (safe defaults if unset)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VOICE_ENABLED=true       # mic button + /api/transcribe
INGEST_V2=                           # 'true' enables body+linked-HTML ingestion v2
STREETEASY_SYNC_ENABLED=             # 'true' enables StreetEasy status sync
HALLUCINATION_GUARD_ENABLED=         # chat hallucination guard toggle
MATCHING_MAX_CANDIDATES=             # cap on matcher candidate fan-out
MATCHING_SPEND_KILL_SWITCH_USD=      # hard spend cap for the matcher
NOMINATIM_MIN_INTERVAL_MS=           # rate-limit for Nominatim geocoding

# ---------------------------------------------------------------------------
# OPTIONAL — external enrichment / data providers (features degrade if unset)
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=                 # geocoding / location (preferred for address accuracy)
NYC_SOCRATA_KEY_ID=                  # NYC PLUTO/ACRIS propertyType enrichment
NYC_SOCRATA_KEY_SECRET=
SOCRATA_APP_TOKEN=
RAPIDAPI_KEY=                        # StreetEasy data via RapidAPI
RAPIDAPI_SE_HOST=
SE_USER_AUTH_TOKEN=                  # StreetEasy authenticated fetch
SE_REMEMBER_USER_TOKEN=
BRIGHTDATA_API_KEY=                  # scraping proxy
BRIGHTDATA_ZONE=
JINA_API_KEY=                        # reader / embeddings fallback
LLAMAPARSE_API_KEY=                  # PDF/doc parsing
SCRAPINGBEE_API_KEY=                 # scraping fallback
INSTANTLY_API_KEY=                   # outreach (out of MVP scope)
FRED_API_KEY=                        # macro/market-report data

# ---------------------------------------------------------------------------
# ADMIN / MAINTENANCE — leave unset in normal operation
# ---------------------------------------------------------------------------
ADMIN_SECRET=                        # guards /api/admin/* maintenance routes
CONFIRM_WIPE=                        # destructive-wipe confirmation gate (never set in prod)

# ---------------------------------------------------------------------------
# FALLBACK / AUTO — usually not needed in Vercel
# ---------------------------------------------------------------------------
# Manual Graph token fallback. NOT needed on Vercel: the OAuth callback stores
# the live token in the DB (connectedMailbox 'runtime-token'), which getToken()
# reads first. Leave blank in prod.
MICROSOFT_GRAPH_ACCESS_TOKEN=
# SHADOW_DATABASE_URL — only used by `prisma migrate dev` locally. Not needed on Vercel.
SHADOW_DATABASE_URL=
# NODE_ENV is set automatically by Next/Vercel — do not set manually.
